# ── Supabase (a tulajdonos SAJÁT projektje) ──────────────────────────
# Supabase → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # a "service_role" kulcs, SOHA nem kerülhet böngészőbe

# ── Stripe ───────────────────────────────────────────────────────────
# Stripe Dashboard → Developers → Webhooks → a létrehozott endpoint "Signing secret"-je.
# FONTOS: Stripe API kulcs (sk_...) NEM kell! A rendszer nem fér hozzá a Stripe fiókhoz,
# csak a beérkező értesítések aláírását ellenőrzi ezzel.
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Munkamenet titok ─────────────────────────────────────────────────
# Bármilyen hosszú véletlen szöveg. Generálás: https://generate-secret.vercel.app/32
SESSION_SECRET=ide-egy-hosszu-veletlen-szoveg

# ── Átirányítás célja ────────────────────────────────────────────────
# Ahová a partneri link kattintói érkeznek az ÉR oldalán.
ER_REDIRECT_URL=https://etkezesirendszer.hu/bemutato

# ── Cookie domain (opcionális, de ajánlott) ──────────────────────────
# Ha ez az app a partner.etkezesirendszer.hu címen fut, állítsd be így,
# és a kattintási cookie a fő oldalon is látszani fog:
COOKIE_DOMAIN=.etkezesirendszer.hu
